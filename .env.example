# ------------------------------------------------------------------
# eRetail clone — environment variables (MongoDB edition)
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- MongoDB connection (server-side) ---
# Get this from MongoDB Atlas: Connect -> Drivers -> copy the URI.
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# If left BLANK, the app automatically uses a built-in in-memory store with the
# same seed data, so it still works with zero setup.
MONGODB_URI=
MONGODB_DB=eretail

# --- Port the Express server listens on (Render sets PORT automatically) ---
PORT=3002

# --- Live demo exploration (Playwright scripts only — never commit real values) ---
# Used by: node scripts/explore-reference.mjs
ERETAIL_DEMO_USER=
ERETAIL_DEMO_PASSWORD=
